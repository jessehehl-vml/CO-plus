        "field": "${dsp-signal.dsp-creativeid}",
        "type": "exact-match",
        "predicate": "="
      },
      {
        "name": "DSP Deal ID",
        "field": "${dsp-signal.dsp-dealid}",
        "type": "exact-match",
        "predicate": "="
      },
      {
        "name": "DSP IO ID",
