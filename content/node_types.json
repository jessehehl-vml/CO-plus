[
  {
    "name": "date-time",
    "icon": "schedule",
    "triggers": [
      {
        "name": "Weekly recurring",
        "field": "${datetime.day-of-week}",
        "type": "day-of-week",
        "predicate": "in"
      },
      {
        "name": "Daily recurring",
        "field": "${datetime.time-of-day}",
        "type": "time-of-day",
        "predicate": "in-range"
      },
      {
        "name": "Exact date/time",
        "field": "${datetime.timestamp}",
        "type": "timestamp",
        "predicate": "in-range"
      }
    ]
  },
  {
    "name": "weather",
    "icon": "cloud",
    "triggers": [
      {
        "name": "Today's weather condition",
        "field": "${weather.weather-of-today}",
        "type": "exact-match",
        "predicate": "="
      },
      {
        "name": "Tomorrow's weather condition",
        "field": "${weather.weather-of-tomorrow}",
        "type": "exact-match",
        "predicate": "="
      }
    ]
  },
  {
    "name": "location",
    "icon": "location_on",
    "triggers": [
      {
        "name": "City",
        "field": "${location.city}",
        "type": "exact-match",
        "predicate": "="
      },
      {
        "name": "Country",
        "field": "${location.country}",
        "type": "exact-match",
        "predicate": "="
      }
    ]
  },
  {
    "name": "dsp-signal",
